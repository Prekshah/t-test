ess' \n                                  : `▶ ... and ${covariateAnalysis.otherCovariates.length - 5} more`\n                                }\n                              </Typography>\n                            )}\n                          </Box>\n                        </Box>\n                      )}\n                    </Box>\n                  ) : (\n                    <Alert severity=\"info\">\n                      <Typography variant=\"body1\">\n                        No suitable covariate columns found for CUPED analysis.\n                        <br />\n                        Requirements: Numeric columns with correlation &lt; 0.1 with grouping variable and sufficient correlation with outcome metric.\n                      </Typography>\n                    </Alert>\n                  )}\n                </Paper>\n              )}\n\n              <FormControl fullWidth sx={{ mb: 2 }}>\n                <InputLabel>Grouping Column</InputLabel>\n                <Select\n                  value={groupingColumn}\n                  onChange={handleGroupingChange}\n                  label=\"Grouping Column\"\n                >\n                  {columns.map(column => (\n                    <MenuItem key={column} value={column}>{column}</MenuItem>\n                  ))}\n                </Select>\n              </FormControl>\n\n              {/* High Precision CI Toggle for Bootstrapping */}\n              {isMetricContinuous && metricColumn && groupingColumn && (\n                <Paper sx={{ p: 2, mb: 2, bgcolor: '#f8f9fa', border: '1px solid #e0e0e0' }}>\n                  <FormControlLabel\n                    control={\n                      <Switch\n                        checked={needHighPrecisionCI}\n                        onChange={(e) => setNeedHighPrecisionCI(e.target.checked)}\n                        sx={{\n                          '& .MuiSwitch-switchBase.Mui-checked': {\n                            color: '#1976d2'\n                          },\n                          '& .MuiSwitch-switchBase.Mui-checked + .MuiSwitch-track': {\n                            backgroundColor: '#1976d2'\n                          }\n                        }}\n                      />\n                    }\n                    label={\n                      <Box>\n                        <Typography variant=\"body2\" sx={{ fontWeight: 600, color: '#1976d2' }}>\n                          🎯 Request High-Precision Confidence Intervals\n                        </Typography>\n                        <Typography variant=\"caption\" sx={{ color: '#666', display: 'block', mt: 0.5 }}>\n                          Forces bootstrap analysis for more robust confidence intervals when comparing means.\n                          Automatically enabled for borderline p-values or highly skewed data.\n                        </Typography>\n                      </Box>\n                    }\n                  />\n                </Paper>\n              )}\n\n              {metricColumn && groupingColumn && (\n                <Box>\n                  <Typography variant=\"h6\" sx={{ mb: 2, color: '#000000', fontWeight: 500 }}>\n                    Group Statistics\n                  </Typography>\n                  \n                  {isCalculating ? (\n                    <TableLoadingSkeleton />\n                  ) : (\n                    <TableContainer component={Paper} sx={{ mb: 3 }}>\n                      <Table>\n                        <TableHead>\n                          <TableRow sx={{ backgroundColor: '#f8f9fa' }}>\n                            <TableCell>Group</TableCell>\n                            <TableCell>Count</TableCell>\n                            {isMetricContinuous ? (\n                              <>\n                                <TableCell>Mean</TableCell>\n                                <TableCell>5% Trimmed Mean</TableCell>\n                                <TableCell>Skewness</TableCell>\n                                <TableCell>Kurtosis</TableCell>\n                                <TableCell>Mean Diff %</TableCell>\n                              </>\n                            ) : (\n                              <>\n                                <TableCell>Proportion</TableCell>\n                                <TableCell>Standard Error</TableCell>\n                                <TableCell>95% CI Lower</TableCell>\n                                <TableCell>95% CI Upper</TableCell>\n                              </>\n                            )}\n                          </TableRow>\n                        </TableHead>\n                        <TableBody>\n                          {Object.entries(groupStats).map(([group, stats]) => (\n                            <TableRow key={group}>\n                              <TableCell>{group}</TableCell>\n                              <TableCell>{stats.count}</TableCell>\n                              {isMetricContinuous ? (\n                                <>\n                                  <TableCell>{stats.mean.toFixed(3)}</TableCell>\n                                  <TableCell>{stats.trimmedMean.toFixed(3)}</TableCell>\n                                  <TableCell>{stats.skewness.toFixed(3)}</TableCell>\n                                  <TableCell>{stats.kurtosis.toFixed(3)}</TableCell>\n                                  <TableCell>{stats.meanDiffPercentage.toFixed(1)}%</TableCell>\n                                </>\n                              ) : (\n                                <>\n                                  <TableCell>{(stats.proportion || 0).toFixed(3)}</TableCell>\n                                  <TableCell>{(stats.proportionStdError || 0).toFixed(3)}</TableCell>\n                                  <TableCell>\n                                    {(stats.proportion && stats.proportionStdError\n                                      ? stats.proportion - 1.96 * stats.proportionStdError\n                                      : 0\n                                    ).toFixed(3)}\n                                  </TableCell>\n                                  <TableCell>\n                                    {(stats.proportion && stats.proportionStdError\n                                      ? stats.proportion + 1.96 * stats.proportionStdError\n                                      : 0\n                                    ).toFixed(3)}\n                                  </TableCell>\n                                </>\n                              )}\n                            </TableRow>\n                          ))}\n                        </TableBody>\n                      </Table>\n                    </TableContainer>\n                  )}\n\n                  {isMetricContinuous && (\n                    <>\n                      {isCalculating ? (\n                        Object.keys(groupStats).map((_, index) => (\n                          <ReliabilityCheckSkeleton key={index} />\n                        ))\n                      ) : (\n                        Object.entries(groupStats).map(([group, stats]) => (\n                          <ReliabilityCheck\n                            key={group}\n                            group={group}\n                            stats={stats}\n                            leveneTest={leveneTest}\n                            testName={testRecommendation?.testName}\n                          />\n                        ))\n                      )}\n\n                      <Typography variant=\"h6\" sx={{ mb: 2, mt: 4, color: '#000000', fontWeight: 500 }}>\n                        Distribution Plots\n                      </Typography>\n                      <Grid container spacing={4}>\n                        {Object.entries(groupStats).map(([group, stats]) => (\n                          <Grid item xs={12} md={6} key={group}>\n                            <Paper sx={{ p: 3, height: '100%' }}>\n                              <Suspense fallback={\n                                <Box sx={{ display: 'flex', justifyContent: 'center', alignItems: 'center', height: 300 }}>\n                                  <CircularProgress />\n                                </Box>\n                              }>\n                                <HistogramPlotLazy data={stats.values} groupName={group} />\n                              </Suspense>\n                            </Paper>\n                          </Grid>\n                        ))}\n                      </Grid>\n                    </>\n                  )}\n                </Box>\n              )}\n            </Box>\n          </TabPanel>\n\n          <TabPanel value={tabValue} index={1}>\n            <Box>\n              {metricColumn && groupingColumn ? (\n                <>\n                  <Typography variant=\"h6\" sx={{ mb: 3, color: '#1976d2', fontWeight: 500 }}>\n                    Statistical Test Recommendation\n                  </Typography>\n\n                  {(() => {\n                    if (!testRecommendation) return null;\n\n                    return (\n                      <Paper sx={{ p: 3, bgcolor: '#f8f9fa' }}>\n                        <Box sx={{ mb: 3 }}>\n                          <Typography variant=\"h6\" sx={{ color: '#2e7d32', mb: 1 }}>\n                            Selected Test\n                          </Typography>\n                          <Typography variant=\"body1\" sx={{ fontWeight: 500 }}>\n                            {testRecommendation.testName}\n                          </Typography>\n                        </Box>\n\n                        <Box sx={{ mb: 3 }}>\n                          <Typography variant=\"h6\" sx={{ color: '#2e7d32', mb: 1 }}>\n                            Post-hoc Analysis\n                          </Typography>\n                          <Typography variant=\"body1\">\n                            {testRecommendation.requiresPostHoc ? (\n                              <>\n                                Required - {testRecommendation.postHocMethod}\n                              </>\n                            ) : (\n                              \"Not required\"\n                            )}\n                          </Typography>\n                        </Box>\n\n                        <Box>\n                          <Typography variant=\"h6\" sx={{ color: '#2e7d32', mb: 1 }}>\n                            Reasoning\n                          </Typography>\n                          <Typography \n                            variant=\"body1\" \n                            component=\"div\"\n                            sx={{ \n                              whiteSpace: 'pre-line',\n                              '& > div': {\n                                marginBottom: '4px'\n                              }\n                            }}\n                          >\n                            {testRecommendation.reasoning.split('\\n').map((line, index) => (\n                              <div key={index}>{line}</div>\n                            ))}\n                          </Typography>\n                        </Box>\n                      </Paper>\n                    );\n                  })()}\n                </>\n              ) : (\n                <Alert severity=\"info\">\n                  Please select both a metric column and a grouping column in the Metric Visualization tab to get test recommendations.\n                </Alert>\n              )}\n            </Box>\n          </TabPanel>\n\n          <TabPanel value={tabValue} index={2}>\n            <Box>\n              {metricColumn && groupingColumn && testRecommendation ? (\n                <>\n                  <Typography variant=\"h6\" sx={{ mb: 3, color: '#1976d2', fontWeight: 500 }}>\n                    Statistical Test Execution\n                  </Typography>\n\n                  {/* CUPED Toggle - Only show if CUPED is applicable */}\n                  {covariateAnalysis && covariateAnalysis.selectedCovariate && isMetricContinuous && columns.includes(covariateAnalysis.selectedCovariate) && (\n                    <Paper sx={{ p: 3, mb: 3, bgcolor: '#f8f9ff', border: '1px solid #1976d2' }}>\n                      <Box sx={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between' }}>\n                        <Box>\n                          <Typography variant=\"h6\" sx={{ color: '#1976d2', fontWeight: 600, mb: 1 }}>\n                            🎯 CUPED Adjustment\n                          </Typography>\n                          <Typography variant=\"body2\" sx={{ color: '#666' }}>\n                            Use CUPED-adjusted metrics for enhanced statistical power\n                          </Typography>\n                        </Box>\n                                                 <FormControlLabel\n                           control={\n                             <Switch\n                               checked={applyCUPED}\n                               onChange={(e) => {\n                                 setApplyCUPED(e.target.checked);\n                                 // Reset test results when toggle changes to force recalculation\n                                 if (testResult) {\n                                   setTestResult(null);\n                                   setInputsChanged(true);\n                                 }\n                               }}\n                               sx={{\n                                 '& .MuiSwitch-switchBase.Mui-checked': {\n                                   color: '#1976d2'\n                                 },\n                                 '& .MuiSwitch-switchBase.Mui-checked + .MuiSwitch-track': {\n                                   backgroundColor: '#1976d2'\n                                 }\n                               }}\n                             />\n                           }\n                          label={\n                            <Typography variant=\"body1\" sx={{ fontWeight: 500, color: applyCUPED ? '#1976d2' : '#666' }}>\n                              Apply CUPED adjustment\n                            </Typography>\n                          }\n                        />\n                      </Box>\n                    </Paper>\n                  )}\n\n                  {inputsChanged && testResult && (\n                    <Alert severity=\"warning\" sx={{ mb: 3 }}>\n                      <Typography variant=\"body1\">\n                        <strong>Inputs Changed - Results Outdated</strong>\n                        <br />\n                        You have modified the metric or grouping column. Please run the test again to generate new results with the updated parameters.\n                      </Typography>\n                    </Alert>\n                  )}\n\n                  <Box sx={{ mb: 3 }}>\n                    <Button\n                      variant=\"contained\"\n                      onClick={executeStatisticalTest}\n                      disabled={isRunningTest}\n                      sx={{\n                        backgroundColor: '#1976d2',\n                        '&:hover': { backgroundColor: '#1565c0' },\n                        fontWeight: 500,\n                        px: 4,\n                        py: 1\n                      }}\n                    >\n                      {isRunningTest ? (\n                        <>\n                          <CircularProgress size={20} sx={{ mr: 1, color: 'white' }} />\n                          Running Test...\n                        </>\n                      ) : (\n                        `Run ${testRecommendation.testName}`\n                      )}\n                    </Button>\n                  </Box>\n\n                  {/* CUPED OFF Message - Show when CUPED is available but toggle is OFF */}\n                  {!applyCUPED && 